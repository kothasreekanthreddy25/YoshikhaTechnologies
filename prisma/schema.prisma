generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Experience {
  NEW_TO_CODING
  SOME_EXPERIENCE
  WORKING_DEVELOPER
}

model Student {
  id         String     @id @default(cuid())
  fullName   String
  email      String     @unique
  phone      String
  courseSlug String
  experience Experience
  goals      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([courseSlug])
}
